#
#	For the alternate executable:
#	RESOLUTION 0 - Use setting from Options Screen, 1 - 512x384, 2 - 640x480, 3 - 720x540, 4 - 960x720, 5- 1440x1080, 6 - 1920x1440, 7 - 2880x2160
#

Res.RESOLUTION	4

